# Supabase (Beach groups hub: check-in + mesh bags)
# Create a free project at https://supabase.com then copy Project URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheets webhook for mesh bag requests (server-only — never NEXT_PUBLIC_)
# Deploy scripts/google-apps-script/mesh-bag-requests.gs as a Web App and paste the URL.
GOOGLE_SHEETS_WEBHOOK_URL=
